# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — from Dashboard > Developers > API keys (use TEST keys while building)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — from `stripe listen` output, or Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL of your app (used for Stripe Connect onboarding return/refresh links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform's cut of each booking, as a decimal (0.07 = 7%)
PLATFORM_FEE_PERCENT=0.07
